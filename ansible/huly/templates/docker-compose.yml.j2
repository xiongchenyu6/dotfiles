# Managed by ansible/huly — adapted from hcengineering/huly-selfhost compose.yml.
# Do not edit on the host.
name: huly
services:
  nginx:
    image: {{ huly_nginx_image }}
    container_name: huly-nginx
    ports:
      - "{{ huly_bind_host }}:{{ huly_port }}:80"
    volumes:
      - ./huly.nginx.conf:/etc/nginx/conf.d/default.conf:ro
    restart: unless-stopped
    networks: [huly_net]

  cockroach:
    image: {{ huly_cockroach_image }}
    container_name: huly-cockroach
    command: start-single-node --accept-sql-without-tls
    environment:
      - COCKROACH_DATABASE={{ huly_cr_database }}
      - COCKROACH_USER={{ huly_cr_username }}
      - COCKROACH_PASSWORD={{ huly_cr_password }}
    volumes:
      - ./data/cr_data:/cockroach/cockroach-data
      - ./data/cr_certs:/cockroach/certs
    restart: unless-stopped
    networks: [huly_net]

  redpanda:
    image: {{ huly_redpanda_image }}
    container_name: huly-redpanda
    command:
      - redpanda
      - start
      - --kafka-addr internal://0.0.0.0:9092,external://0.0.0.0:19092
      - --advertise-kafka-addr internal://redpanda:9092,external://localhost:19092
      - --pandaproxy-addr internal://0.0.0.0:8082,external://0.0.0.0:18082
      - --advertise-pandaproxy-addr internal://redpanda:8082,external://localhost:18082
      - --schema-registry-addr internal://0.0.0.0:8081,external://0.0.0.0:18081
      - --rpc-addr redpanda:33145
      - --advertise-rpc-addr redpanda:33145
      - --mode dev-container
      - --smp 1
      - --default-log-level=info
    volumes:
      - ./data/redpanda:/var/lib/redpanda/data
    environment:
      - REDPANDA_SUPERUSER_USERNAME={{ huly_redpanda_admin_user }}
      - REDPANDA_SUPERUSER_PASSWORD={{ huly_redpanda_password }}
    # dev-container mode leaves SASL off, so the superuser above is only a
    # bootstrap for the day it is turned on. Probing with SASL credentials
    # against a broker that has no SASL gets ILLEGAL_SASL_STATE, so the check
    # connects plain — exactly as the Huly services do.
    healthcheck:
      test: ['CMD', 'rpk', 'cluster', 'info']
      interval: 10s
      timeout: 5s
      retries: 10
    deploy:
      resources:
        limits:
          memory: {{ huly_redpanda_mem_limit }}
    restart: unless-stopped
    networks: [huly_net]

  minio:
    image: {{ huly_minio_image }}
    container_name: huly-minio
    command: server /data --address ":9000" --console-address ":9001"
    environment:
      - MINIO_ROOT_USER={{ huly_minio_access_key }}
      - MINIO_ROOT_PASSWORD={{ huly_minio_secret_key }}
    volumes:
      - ./data/files:/data
    healthcheck:
      test: ['CMD', 'mc', 'ready', 'local']
      interval: 5s
      retries: 10
    restart: unless-stopped
    networks: [huly_net]

  elastic:
    image: {{ huly_elastic_image }}
    container_name: huly-elastic
    command: |
      /bin/sh -c "./bin/elasticsearch-plugin list | grep -q ingest-attachment || yes | ./bin/elasticsearch-plugin install --silent ingest-attachment;
      /usr/local/bin/docker-entrypoint.sh eswrapper"
    volumes:
      - ./data/elastic:/usr/share/elasticsearch/data
    environment:
      - ELASTICSEARCH_PORT_NUMBER=9200
      - discovery.type=single-node
      - ES_JAVA_OPTS=-Xms{{ huly_elastic_heap }} -Xmx{{ huly_elastic_heap }}
      - http.cors.enabled=true
    healthcheck:
      interval: 20s
      retries: 10
      test: curl -s http://localhost:9200/_cluster/health | grep -vq '"status":"red"'
    deploy:
      resources:
        limits:
          memory: {{ huly_elastic_mem_limit }}
    restart: unless-stopped
    networks: [huly_net]

  rekoni:
    image: hardcoreeng/rekoni-service:{{ huly_version }}
    container_name: huly-rekoni
    environment:
      - SECRET={{ huly_secret }}
    deploy:
      resources:
        limits:
          memory: {{ huly_rekoni_mem_limit }}
    restart: unless-stopped
    networks: [huly_net]

  transactor:
    image: hardcoreeng/transactor:{{ huly_version }}
    container_name: huly-transactor
    environment:
      - SERVER_PORT=3333
      - SERVER_SECRET={{ huly_secret }}
      - DB_URL={{ huly_cr_db_url }}
      - STORAGE_CONFIG={{ huly_storage_config }}
      - FRONT_URL=https://{{ huly_domain }}
      - ACCOUNTS_URL=http://account:3000
      - FULLTEXT_URL=http://fulltext:4700
      - STATS_URL=http://stats:4900
      - LAST_NAME_FIRST={{ huly_last_name_first | lower }}
      - QUEUE_CONFIG=redpanda:9092
    restart: unless-stopped
    networks: [huly_net]

  collaborator:
    image: hardcoreeng/collaborator:{{ huly_version }}
    container_name: huly-collaborator
    environment:
      - COLLABORATOR_PORT=3078
      - SECRET={{ huly_secret }}
      - ACCOUNTS_URL=http://account:3000
      - STATS_URL=http://stats:4900
      - STORAGE_CONFIG={{ huly_storage_config }}
    restart: unless-stopped
    networks: [huly_net]

  account:
    image: hardcoreeng/account:{{ huly_version }}
    container_name: huly-account
    environment:
      - SERVER_PORT=3000
      - SERVER_SECRET={{ huly_secret }}
      - DB_URL={{ huly_cr_db_url }}
      - TRANSACTOR_URL=ws://transactor:3333;wss://{{ huly_domain }}/_transactor
      - STORAGE_CONFIG={{ huly_storage_config }}
      - FRONT_URL=https://{{ huly_domain }}
      - STATS_URL=https://{{ huly_domain }}/_stats
      - MODEL_ENABLED=*
      - ACCOUNTS_URL=https://{{ huly_domain }}/_accounts
      - ACCOUNT_PORT=3000
      - QUEUE_CONFIG=redpanda:9092
{% if huly_oidc_enabled and huly_oidc_client_id | default('') | length > 0 %}
      # Auth0 sign-in/sign-up; the callback is
      # https://{{ huly_domain }}/_accounts/auth/openid/callback
      - OPENID_CLIENT_ID={{ huly_oidc_client_id }}
      - OPENID_CLIENT_SECRET={{ huly_oidc_client_secret }}
      - OPENID_ISSUER=https://{{ huly_auth0_domain }}/
{% endif %}
    restart: unless-stopped
    networks: [huly_net]

  workspace:
    image: hardcoreeng/workspace:{{ huly_version }}
    container_name: huly-workspace
    environment:
      - SERVER_SECRET={{ huly_secret }}
      - DB_URL={{ huly_cr_db_url }}
      - TRANSACTOR_URL=ws://transactor:3333;wss://{{ huly_domain }}/_transactor
      - STORAGE_CONFIG={{ huly_storage_config }}
      - MODEL_ENABLED=*
      - ACCOUNTS_URL=http://account:3000
      - STATS_URL=http://stats:4900
      - QUEUE_CONFIG=redpanda:9092
      - ACCOUNTS_DB_URL={{ huly_cr_db_url }}
    restart: unless-stopped
    networks: [huly_net]

  front:
    image: hardcoreeng/front:{{ huly_version }}
    container_name: huly-front
    environment:
      - SERVER_PORT=8080
      - SERVER_SECRET={{ huly_secret }}
      - LOVE_ENDPOINT=https://{{ huly_domain }}/_love
      - ACCOUNTS_URL=https://{{ huly_domain }}/_accounts
      - ACCOUNTS_URL_INTERNAL=http://account:3000
      - REKONI_URL=https://{{ huly_domain }}/_rekoni
      - CALENDAR_URL=https://{{ huly_domain }}/_calendar
      - GMAIL_URL=https://{{ huly_domain }}/_gmail
      - TELEGRAM_URL=https://{{ huly_domain }}/_telegram
      - STATS_URL=https://{{ huly_domain }}/_stats
      - UPLOAD_URL=/files
      - ELASTIC_URL=http://elastic:9200
      - COLLABORATOR_URL=wss://{{ huly_domain }}/_collaborator
      - STORAGE_CONFIG={{ huly_storage_config }}
      - TITLE={{ huly_title }}
      - DEFAULT_LANGUAGE={{ huly_default_language }}
      - LAST_NAME_FIRST={{ huly_last_name_first | lower }}
      - DISABLED_FEATURES=auto-translate,mailboxes
    restart: unless-stopped
    networks: [huly_net]

  fulltext:
    image: hardcoreeng/fulltext:{{ huly_version }}
    container_name: huly-fulltext
    environment:
      - SERVER_SECRET={{ huly_secret }}
      - DB_URL={{ huly_cr_db_url }}
      - FULLTEXT_DB_URL=http://elastic:9200
      - ELASTIC_INDEX_NAME=huly_storage_index
      - STORAGE_CONFIG={{ huly_storage_config }}
      - REKONI_URL=http://rekoni:4004
      - ACCOUNTS_URL=http://account:3000
      - STATS_URL=http://stats:4900
      - QUEUE_CONFIG=redpanda:9092
    restart: unless-stopped
    networks: [huly_net]

  stats:
    image: hardcoreeng/stats:{{ huly_version }}
    container_name: huly-stats
    environment:
      - PORT=4900
      - SERVER_SECRET={{ huly_secret }}
    restart: unless-stopped
    networks: [huly_net]

  kvs:
    image: hardcoreeng/hulykvs:{{ huly_version }}
    container_name: huly-kvs
    depends_on:
      cockroach:
        condition: service_started
    environment:
      - HULY_DB_CONNECTION={{ huly_cr_db_url }}
      - HULY_TOKEN_SECRET={{ huly_secret }}
    restart: unless-stopped
    networks: [huly_net]

networks:
  huly_net:
