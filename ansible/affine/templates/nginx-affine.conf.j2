# AFFiNE reverse proxy for {{ affine_domain }}
# Managed by ansible/affine.

upstream affine_backend { server 127.0.0.1:{{ affine_port }}; keepalive 16; }

server {
    listen 80;
    listen [::]:80;
    server_name {{ affine_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ affine_domain }};

    ssl_certificate     {{ affine_ssl_cert }};
    ssl_certificate_key {{ affine_ssl_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    access_log /var/log/nginx/affine.access.log;
    error_log  /var/log/nginx/affine.error.log;

    # Attachment uploads; kept under the Cloudflare free-plan body cap.
    client_max_body_size 100M;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    # AFFiNE syncs documents over a long-lived socket.
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    proxy_buffering    off;

    location / {
        proxy_pass http://affine_backend;
    }
}
