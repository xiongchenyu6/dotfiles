# Managed by ansible/ntfy — do not edit on the host.
name: ntfy
services:
  ntfy:
    image: {{ ntfy_image }}
    container_name: ntfy
    restart: unless-stopped
    command: serve
    ports:
      - "{{ ntfy_bind_host }}:{{ ntfy_port }}:80"
    volumes:
      - ./server.yml:/etc/ntfy/server.yml:ro
      - ./data:/var/lib/ntfy
    environment:
      - TZ={{ ntfy_tz }}
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://localhost/v1/health | grep -Eo '\"healthy\"\\s*:\\s*true' || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

