# ntfy reverse proxy for {{ ntfy_domain }}
# Managed by ansible/ntfy.

upstream ntfy_backend { server 127.0.0.1:{{ ntfy_port }}; }

server {
    listen 80;
    listen [::]:80;
    server_name {{ ntfy_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ ntfy_domain }};

    ssl_certificate     {{ ntfy_ssl_cert }};
    ssl_certificate_key {{ ntfy_ssl_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    access_log /var/log/nginx/ntfy.access.log;
    error_log  /var/log/nginx/ntfy.error.log;

    client_max_body_size 100M;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    # Subscriptions are long-lived streams; never buffer or time them out.
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering     off;
    proxy_request_buffering off;
    proxy_read_timeout  3m;
    proxy_send_timeout  3m;
    proxy_connect_timeout 3s;

    location / {
        proxy_pass http://ntfy_backend;
    }
}
